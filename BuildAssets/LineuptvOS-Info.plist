<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Transport Security is a nested dictionary and has no
	     INFOPLIST_KEY_ form, so INFOPLIST_KEY_NSAppTransportSecurity_NSAllowsArbitraryLoads
	     built cleanly and produced an app without it, exactly as it did on
	     iOS. VLC does its own networking so playback never noticed, but every
	     URLSession call — channels, guide, schedules — has been under default
	     ATS rather than the policy this project has been declaring.

	     Background modes are deliberately absent: tvOS has no background
	     audio and no Picture in Picture here. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Lineup</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Lineup</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<!-- lineup:// is how the Top Shelf and the Home Screen widget open the
	     app at a particular game, channel or title. See LineupLink in
	     Shared/HomeShelf.swift for the shapes it takes. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nulldev85.NullSports.links</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lineup</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
