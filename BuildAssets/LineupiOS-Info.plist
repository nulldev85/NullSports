<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Written by hand rather than generated from INFOPLIST_KEY_* build
	     settings. UIBackgroundModes has to be an array of strings for iOS to
	     grant the capability at all, and the generated plist did not produce
	     one - background playback and Picture in Picture silently did nothing.
	     An explicit file is checked, diffable, and cannot change shape. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Lineup</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Lineup</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- lineup://setup links are an Apple TV's setup code: the Camera app
	     opens them here. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nulldev85.NullSports.setup</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lineup</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Set Up Apple TV finds the TV by the name in its code. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_lineup-setup._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Scan the setup code on your Apple TV to set it up from this iPhone.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to IPTV providers, Jellyfin, Emby, Plex or Silo media servers, and the Apple TV you set up, on your local network.</string>
	<!-- Keeps audio decoding when Lineup is backgrounded, and is what lets
	     AVPictureInPictureController carry a stream into the system window. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Empty dictionary asks UIKit to generate the default launch screen,
	     which is what INFOPLIST_KEY_UILaunchScreen_Generation did before. -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Use the current SDK design so TabView can render Apple's native Liquid
	     Glass. The navigation switch changes only the tab bar's appearance. -->
</dict>
</plist>
